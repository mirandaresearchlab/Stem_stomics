# ▶ Python byte-code and caches
__pycache__/
*.py[cod]
*.pyo
*.so
*.dylib

# ▶ Packaging / build artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/

# ▶ Virtual environments
# (uv uses .venv by default, but catch other names too)
.venv/
venv/
env/
ENV/
.env

# ▶ uv temporary download/cache directory
.uv-cache/

# ▶ Test & coverage outputs
.pytest_cache/
.coverage*
htmlcov/

# ▶ Jupyter & IPython junk
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ▶ Editable installs from PEP 660
*.pth

# ▶ MyPy, Pyre, Pylint, etc.
.mypy_cache/
.pyre/
.pytype/
pylint-report.txt

# ▶ Logs & runtime files
*.log
*.tmp
*.bak
*.swp
*.orig

# ▶ IDE / Editor folders
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ▶ OS-specific cruft
.DS_Store
Thumbs.db

# weights & biases
wandb/
